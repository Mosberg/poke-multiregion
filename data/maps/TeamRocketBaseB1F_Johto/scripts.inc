	waitmovement 1
	call TeamRocketBaseB1F_Johto_TrainerCameraGrunt1_Sub
	goto_if_eq VAR_RESULT, TRUE, TeamRocketBaseB1F_Johto_NoSecurityCamera
	call TeamRocketBaseB1F_Johto_PlaySecurityCameraSounds_Sub
